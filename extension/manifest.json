{
  "manifest_version": 3,
  "name": "Model Shelf",
  "version": "0.4.1",
  "description": "Save 3D model projects \u2014 page, metadata, licence and files \u2014 into Forgejo.",
  "browser_specific_settings": {
    "gecko": {
      "id": "model-shelf@example.com",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.printables.com/*",
    "https://printables.com/*",
    "https://*.thingiverse.com/*",
    "https://thingiverse.com/*",
    "https://*.makerworld.com/*",
    "https://makerworld.com/*",
    "https://*.thangs.com/*",
    "https://thangs.com/*",
    "https://*.cults3d.com/*",
    "https://cults3d.com/*",
    "https://*.youmagine.com/*",
    "https://*.cloudfront.net/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to model shelf",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "optional_host_permissions": [
    "*://*/*"
  ]
}
